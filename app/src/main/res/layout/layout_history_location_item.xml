<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Awalocation.Card.Compact"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/awalocation_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:contentPadding="14dp"
    app:strokeColor="@color/awalocation_outline_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_header_mark"
            android:contentDescription="@null"
            android:padding="11dp"
            app:srcCompat="@drawable/baseline_location_pin_24"
            app:tint="@color/awalocation_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/history_location_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/name"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/awalocation_text_color"
                android:textStyle="bold"
                app:emojiCompatEnabled="true" />

            <TextView
                android:id="@+id/history_location_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/none_none"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/awalocation_on_surface_variant" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/history_location_latlon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge_surface_variant"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="@string/default_latlon"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/awalocation_on_surface_variant"
                app:emojiCompatEnabled="true" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/baseline_keyboard_arrow_down_24"
            android:rotation="270"
            app:tint="@color/awalocation_outline" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
