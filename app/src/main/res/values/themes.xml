<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/awalocation_primary</item>
        <item name="colorOnPrimary">@color/awalocation_on_primary</item>
        <item name="colorPrimaryContainer">@color/awalocation_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/awalocation_on_primary_container</item>
        <item name="colorSecondary">@color/awalocation_secondary</item>
        <item name="colorOnSecondary">@color/awalocation_on_secondary</item>
        <item name="colorSecondaryContainer">@color/awalocation_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/awalocation_on_secondary_container</item>
        <item name="colorSurface">@color/awalocation_surface</item>
        <item name="colorOnSurface">@color/awalocation_on_surface</item>
        <item name="colorSurfaceVariant">@color/awalocation_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/awalocation_on_surface_variant</item>
        <item name="colorOutline">@color/awalocation_outline</item>
        <item name="colorOutlineVariant">@color/awalocation_outline_variant</item>
        <item name="android:colorBackground">@color/awalocation_background</item>
        <item name="android:windowBackground">@color/awalocation_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorControlHighlight">@color/theme_focused_touch</item>
        <item name="searchViewStyle">@style/Awalocation.SearchViewStyle</item>
        <item name="sliderStyle">@style/Awalocation.SliderTheme</item>
        <item name="materialAlertDialogTheme">@style/Awalocation.MaterialAlertDialog</item>
    </style>

    <style name="Awalocation.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/awalocation_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/awalocation_outline_variant</item>
        <item name="contentPadding">20dp</item>
        <item name="cardPreventCornerOverlap">false</item>
        <item name="cardUseCompatPadding">false</item>
    </style>

    <style name="Awalocation.Card.Compact" parent="Awalocation.Card">
        <item name="contentPadding">12dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Awalocation.MapCard" parent="Awalocation.Card.Compact">
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">6dp</item>
    </style>

    <!-- 旧样式名保留为别名，未迁移的页面也会使用新视觉。 -->
    <style name="Awalocation.GlassCard" parent="Awalocation.Card" />

    <style name="Awalocation.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerSize">14dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
    </style>
    <style name="Awalocation.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerSize">14dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
    </style>
    <style name="Awalocation.PillButton" parent="Awalocation.Button" />
    <style name="Awalocation.PillButton.Tonal" parent="Awalocation.Button.Tonal" />

    <style name="Awalocation.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/awalocation_text_color</item>
    </style>
    <style name="Awalocation.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/awalocation_text_color</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Awalocation.BodySecondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/awalocation_on_surface_variant</item>
    </style>
    <style name="Awalocation.PreferenceTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/awalocation_text_color</item>
    </style>
    <style name="Awalocation.PreferenceSummary" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/awalocation_on_surface_variant</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Awalocation.PreferenceValue" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/awalocation_primary</item>
    </style>

    <style name="Awalocation.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceCornerLarge">@style/Awalocation.ShapeAppearance.Dialog</item>
        <item name="colorSurface">@color/awalocation_surface</item>
    </style>
    <style name="Awalocation.ShapeAppearance.Dialog" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">24dp</item>
    </style>
    <style name="Awalocation.ShapeAppearance.NavItem" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="Awalocation.SliderTheme" parent="Widget.Material3.Slider">
        <item name="labelBehavior">gone</item>
    </style>
    <style name="Awalocation.SearchViewStyle" parent="Widget.AppCompat.SearchView" />
    <style name="AppTheme.Awalocation.ToolBarOverlay" parent="ThemeOverlay.Material3.Light">
        <item name="colorControlNormal">@color/theme_appbar_icon_color</item>
        <item name="android:textColorPrimary">@color/theme_appbar_text_color</item>
    </style>
    <style name="AppTheme.Awalocation.PopupTheme" parent="ThemeOverlay.Material3.Light" />

    <!-- 下列主题供悬浮窗等旧组件使用。 -->
    <style name="AppTheme.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="colorAccent">@color/accent</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:textColorSecondary">@color/dark_secondary_text</item>
    </style>
    <style name="AppTheme.Translucent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
    </style>
    <style name="AppTheme.Dialog" parent="ThemeOverlay.AppCompat.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="AppTheme.MaterialButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerSize">14dp</item>
    </style>
    <style name="CardViewStyle.Dark" parent="CardView">
        <item name="cardBackgroundColor">@color/awalocation_surface</item>
    </style>
    <style name="CardViewStyle.Light" parent="CardView">
        <item name="cardBackgroundColor">@color/awalocation_surface</item>
    </style>
    <style name="AppTheme.StatusBar" parent="AppTheme">
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    <style name="AppTheme.StatusBar.Dark" parent="AppTheme.Dark">
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
