<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- 摇杆圆盘 -->
    <com.nanci.awalocation.android.widget.RockerView
        android:id="@+id/rocker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        app:areaBackground="#7A0F1A2E"
        app:rockerBackground="#F7FFFFFF" />

    <!-- 胶囊控制面板 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/rocker_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:cardMaxElevation="8dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false"
        app:contentPadding="4dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/rocker_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- 拖动把手：拖动这里移动整个悬浮窗 -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/drag_handle"
                android:layout_width="56dp"
                android:layout_height="20dp"
                android:layout_gravity="center_horizontal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/drag_rocker"
                android:paddingStart="18dp"
                android:paddingTop="4dp"
                android:paddingEnd="18dp"
                android:paddingBottom="4dp"
                android:src="@drawable/baseline_drag_handle_24"
                app:tint="?attr/colorOnSurfaceVariant" />

            <!-- 主控制行：展开时显示 [收起/展开] [自动移动]；收起时保留 [展开] -->
            <LinearLayout
                android:id="@+id/rocker_row_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/move"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/toggle_rocker_collapse"
                    android:padding="9dp"
                    android:src="@drawable/baseline_adjust_24"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/auto"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/toggle_rocker_auto_panel"
                    android:padding="9dp"
                    android:src="@drawable/baseline_robot_24"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <!-- 自动控制子行：展开时受 auto 按钮控制，收起时并入单行横向胶囊 -->
            <LinearLayout
                android:id="@+id/auto_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/auto_play"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/rocker_auto_play"
                    android:padding="9dp"
                    android:src="@drawable/baseline_play_24"
                    app:tint="?attr/colorPrimary" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/auto_lock"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/rocker_auto_lock"
                    android:padding="9dp"
                    android:src="@drawable/baseline_manual_24"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
