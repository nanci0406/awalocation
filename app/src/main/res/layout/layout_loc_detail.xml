<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Portal.Card.Compact"
    android:layout_width="310dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/portal_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:contentPadding="16dp"
    app:strokeColor="@color/portal_outline_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                app:srcCompat="@drawable/baseline_location_on_24"
                app:tint="@color/portal_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/address"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/portal_primary"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/loc_addr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textColor="@color/portal_text_color"
            android:textIsSelectable="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0.8dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="@color/portal_outline_variant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/latlon"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="@color/portal_on_surface_variant" />

        <TextView
            android:id="@+id/loc_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge_surface_variant"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/portal_text_color"
            android:textIsSelectable="true" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
