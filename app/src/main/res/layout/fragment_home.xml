<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.home.HomeFragment">

    <com.amap.api.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <!-- 首次定位前盖住地图，避免先闪一下默认城市 -->
    <FrameLayout
        android:id="@+id/home_map_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/awalocation_background"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/awalocation_surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:contentPadding="24dp"
            app:strokeColor="@color/awalocation_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/awalocation_primary"
                    app:indicatorSize="34dp"
                    app:trackThickness="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/current_location_loading"
                    android:textAppearance="@style/Awalocation.BodySecondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- 顶部搜索与当前地址 -->
    <LinearLayout
        android:id="@+id/home_top_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/home_search_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/awalocation_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:contentPadding="0dp"
            app:strokeColor="@color/awalocation_outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/baseline_search_24"
                        app:tint="@color/awalocation_primary" />

                    <TextView
                        android:id="@+id/home_search_hint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/search_hint"
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textColor="@color/awalocation_hint_color" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.8dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/awalocation_outline_variant" />

                <LinearLayout
                    android:id="@+id/home_address_row"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null"
                        app:srcCompat="@drawable/baseline_location_on_24"
                        app:tint="@color/awalocation_success" />

                    <TextView
                        android:id="@+id/home_current_address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/current_location_loading"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="@color/awalocation_on_surface_variant" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/awalocation_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:contentPadding="0dp"
                app:strokeColor="@color/awalocation_outline_variant"
                app:strokeWidth="1dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/show_route"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:gravity="center_vertical"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:text="@string/show_route"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="@color/awalocation_text_color"
                    app:buttonTint="@color/awalocation_primary" />
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/awalocation_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:contentPadding="2dp"
                app:strokeColor="@color/awalocation_outline_variant"
                app:strokeWidth="1dp">

                <RadioGroup
                    android:id="@+id/map_type_group"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_pill"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <RadioButton
                        android:id="@+id/map_type_normal"
                        android:layout_width="66dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_map_type_selector"
                        android:button="@null"
                        android:checked="true"
                        android:gravity="center"
                        android:text="@string/normal_view"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="@color/map_type_text_color" />

                    <RadioButton
                        android:id="@+id/map_type_satellite"
                        android:layout_width="66dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_map_type_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:text="@string/satellite_view"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="@color/map_type_text_color" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- 自定义地图缩放控件 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/map_zoom_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="96dp"
        app:cardBackgroundColor="@color/awalocation_surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:contentPadding="2dp"
        app:strokeColor="@color/awalocation_outline_variant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/zoom_in"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/zoom_in"
                android:padding="11dp"
                android:src="@drawable/ic_map_zoom_in"
                app:tint="@color/awalocation_primary" />

            <View
                android:layout_width="24dp"
                android:layout_height="0.8dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/awalocation_outline_variant" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/zoom_out"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/zoom_out"
                android:padding="11dp"
                android:src="@drawable/ic_map_zoom_out"
                app:tint="@color/awalocation_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 底部悬浮操作按钮组 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/quick_actions"
            app:backgroundTint="@color/awalocation_primary"
            app:borderWidth="0dp"
            app:elevation="4dp"
            app:fabSize="normal"
            app:srcCompat="@drawable/baseline_keyboard_arrow_up_24"
            app:tint="@color/awalocation_on_primary" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_my_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/follow_location"
            android:visibility="gone"
            app:backgroundTint="@color/awalocation_surface"
            app:borderWidth="0dp"
            app:elevation="3dp"
            app:fabSize="mini"
            app:srcCompat="@drawable/baseline_my_location_24"
            app:tint="@color/awalocation_primary" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_goto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/goto_location"
            android:visibility="gone"
            app:backgroundTint="@color/awalocation_surface"
            app:borderWidth="0dp"
            app:elevation="3dp"
            app:fabSize="mini"
            app:srcCompat="@drawable/baseline_edit_location_alt_24"
            app:tint="@color/awalocation_primary" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/save_location"
            android:visibility="gone"
            app:backgroundTint="@color/awalocation_surface"
            app:borderWidth="0dp"
            app:elevation="3dp"
            app:fabSize="mini"
            app:srcCompat="@drawable/baseline_add_location_alt_24"
            app:tint="@color/awalocation_primary" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
