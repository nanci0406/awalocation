<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".ui.home.HomeFragment">

    <com.amap.api.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true" />

    <!-- 顶部左侧：显示路线悬浮胶囊 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/awalocation_surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:contentPadding="0dp"
        app:strokeColor="@color/awalocation_outline_variant"
        app:strokeWidth="1dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/show_route"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:text="@string/show_route"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="@color/awalocation_text_color"
            app:buttonTint="@color/awalocation_primary" />
    </com.google.android.material.card.MaterialCardView>

    <!-- 顶部右侧：地图图层切换胶囊 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/awalocation_surface"
        app:cardCornerRadius="20dp"
        app:cardElevation="3dp"
        app:contentPadding="2dp"
        app:strokeColor="@color/awalocation_outline_variant"
        app:strokeWidth="1dp">

        <RadioGroup
            android:id="@+id/map_type_group"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_glass_pill"
            android:orientation="horizontal"
            android:padding="3dp">

            <RadioButton
                android:id="@+id/map_type_normal"
                android:layout_width="66dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_map_type_selector"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:text="@string/normal_view"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/map_type_text_color" />

            <RadioButton
                android:id="@+id/map_type_satellite"
                android:layout_width="66dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_map_type_selector"
                android:button="@null"
                android:gravity="center"
                android:text="@string/satellite_view"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="@color/map_type_text_color" />
        </RadioGroup>
    </com.google.android.material.card.MaterialCardView>

    <!-- 底部悬浮操作按钮组 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/quick_actions"
            app:backgroundTint="@color/awalocation_primary"
            app:borderWidth="0dp"
            app:elevation="4dp"
            app:fabSize="normal"
            app:srcCompat="@drawable/baseline_keyboard_arrow_up_24"
            app:tint="@color/awalocation_on_primary" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_my_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/follow_location"
            android:visibility="gone"
            app:backgroundTint="@color/awalocation_surface"
            app:borderWidth="0dp"
            app:elevation="3dp"
            app:fabSize="mini"
            app:srcCompat="@drawable/baseline_my_location_24"
            app:tint="@color/awalocation_primary" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_goto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/goto_location"
            android:visibility="gone"
            app:backgroundTint="@color/awalocation_surface"
            app:borderWidth="0dp"
            app:elevation="3dp"
            app:fabSize="mini"
            app:srcCompat="@drawable/baseline_edit_location_alt_24"
            app:tint="@color/awalocation_primary" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/save_location"
            android:visibility="gone"
            app:backgroundTint="@color/awalocation_surface"
            app:borderWidth="0dp"
            app:elevation="3dp"
            app:fabSize="mini"
            app:srcCompat="@drawable/baseline_add_location_alt_24"
            app:tint="@color/awalocation_primary" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
